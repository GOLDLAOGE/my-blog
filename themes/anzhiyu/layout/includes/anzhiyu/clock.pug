#he-plugin-simple
script(data-pjax).
  if (!window.ensureOptionalWeather) {
    const weatherWidth = window.matchMedia('(min-width: 1401px)');
    let weatherRoot;
    let started = false;
    window.ensureOptionalWeather = function () {
      if (weatherRoot) {
        document.querySelectorAll('#he-plugin-simple').forEach(node => {
          if (node !== weatherRoot) node.remove();
        });
      }
      if (!weatherWidth.matches || started) return;
      weatherRoot = document.getElementById('he-plugin-simple');
      if (!weatherRoot) return;
      document.body.appendChild(weatherRoot);
      started = true;
      window.WIDGET = {
        CONFIG: {
          modules: '0124', background: '2', tmpColor: 'FFFFFF', tmpSize: '16',
          cityColor: 'FFFFFF', citySize: '16', aqiColor: 'E8D87B', aqiSize: '16',
          weatherIconSize: '24', alertIconSize: '18', padding: '10px 10px 10px 10px',
          shadow: '0', language: 'auto', borderRadius: '20', fixed: 'true',
          vertical: 'top', horizontal: 'left', left: '20', top: '7.1',
          key: 'df245676fb434a0691ead1c63341cd94'
        }
      };
      const style = document.createElement('link');
      style.rel = 'stylesheet';
      style.href = 'https://widget.qweather.net/simple/static/css/he-simple.css?v=1.4.0';
      document.head.appendChild(style);
      const script = document.createElement('script');
      script.src = 'https://widget.qweather.net/simple/static/js/he-simple.js?v=1.4.0';
      document.head.appendChild(script);
    };
    weatherWidth.addEventListener('change', window.ensureOptionalWeather);
  }
  window.ensureOptionalWeather();
